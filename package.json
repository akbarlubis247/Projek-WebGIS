{
  "name": "nutrimap-webgis",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"frontend,backend\" -c \"cyan,green\" \"vite\" \"npm --prefix backend-webgis run dev\"",
    "dev:frontend": "vite",
    "dev:backend": "npm --prefix backend-webgis run dev",
    "dev:all": "concurrently -k -n \"frontend,backend\" -c \"cyan,green\" \"vite\" \"npm --prefix backend-webgis run dev\"",
    "start:backend": "npm --prefix backend-webgis start",
    "test:backend": "npm --prefix backend-webgis test",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "countup.js": "^2.10.1",
    "framer-motion": "^13.1.1",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "^3.10.1",
    "vite": "latest"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
